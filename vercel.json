{
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm install --prefer-offline --no-audit --no-fund",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/app/(main\\.js|main\\.css)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "https://exuberant-weasel-22.convex.site/catalog-html/",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1"
      }
    },
    {
      "src": "^/((?:artists|shows|festivals)(?:/[^/]+)?|venues/[^/]+)/?$",
      "dest": "https://exuberant-weasel-22.convex.site/catalog-html/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1"
      }
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "https://exuberant-weasel-22.convex.site/catalog-map/index.xml",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1"
      }
    },
    {
      "src": "^/sitemaps/((?:artists|shows|venues|festivals)-(?:0|[1-9][0-9]{0,4})\\.xml)$",
      "dest": "https://exuberant-weasel-22.convex.site/catalog-map/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(?:sitemap(?:_index|s)?\\.xml|sitemaps(?:/.*)?|seo-meta|seo(?:/.*)?)/?$",
      "status": 410,
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/api/og/?$",
      "dest": "/og-preview.png"
    },
    {
      "src": "/apple-touch-icon-precomposed\\.png",
      "dest": "/apple-touch-icon.png"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:assets|app|api)/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
