{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://exuberant-weasel-22.convex.site/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(signin|signup|profile|sso-callback|spotify-connect|for-artists|admin)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
