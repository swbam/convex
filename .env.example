CONVEX_DEPLOY_KEY=YOUR_CONVEX_DEPLOY_KEY_HERE

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT_NAME_HERE

VITE_CONVEX_URL=https://YOUR_DEPLOYMENT_NAME_HERE.convex.cloud

# PostHog product analytics (the browser project token is intentionally public)
VITE_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_TOKEN
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_PROJECT_ID=YOUR_POSTHOG_PROJECT_ID
# Set these in the Convex dashboard for cron/import lifecycle events.
POSTHOG_PROJECT_TOKEN=YOUR_POSTHOG_PROJECT_TOKEN
POSTHOG_HOST=https://us.i.posthog.com
SITE_URL=https://setlists.live

#-----------------------------------------------------------------------------------------------
# Spotify API Credentials
#-----------------------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

#-----------------------------------------------------------------------------------------------
# Ticketmaster API
#-----------------------------------------------------------------------------------------------
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_API_KEY
# Optional public tracking URL from an approved US Impact agreement with deep linking enabled.
VITE_TICKETMASTER_US_IMPACT_LINK=


SETLISTFM_API_KEY=YOUR_SETLISTFM_API_KEY

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN/.well-known/jwks.json
CLERK_JWT_ISSUER_DOMAIN=https://YOUR_CLERK_DOMAIN
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=YOUR_CLERK_WEBHOOK_SECRET
CLERK_API_KEY=YOUR_CLERK_API_KEY
CLERK_API_VERSION=2023-07-25
CLERK_FRONTEND_API=YOUR_CLERK_FRONTEND_API
